From a3447ccd68404f7941c5dfb375354632886bc560 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Fri, 2 Oct 2026 12:00:00 +0000
Subject: [PATCH 1/4] cmd: blkmap: Block size for memory maps, and reserving their
 memory

A disk image downloaded into RAM and mapped with "blkmap map ... mem"
always gets 512-byte blocks: only a linear map takes the block size of
its target. An image made for a device with 4096-byte logical blocks
(UFS) then has its partition table and file systems read at the wrong
offsets, and U-Boot's FAT driver refuses a FAT whose sector size differs
from the device's.

Let "blkmap create <label> <blksz>" set the block size used by memory
maps. And let "blkmap map ... mem <addr> reserve" reserve the memory in
LMB, so that EFI applications started from that disk (shim, GRUB loading
a kernel and an initramfs) cannot be given pages inside it. LMB reports
the reservation to the EFI memory map as boot services data, so the OS
gets the memory back.

Used on the OnePlus Pad 4 to rehearse the boot of the install image from
RAM: the same image layout and the same EFI boot manager path as the
disk in the userdata partition.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 cmd/blkmap.c | 47 ++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 42 insertions(+), 5 deletions(-)

diff --git a/cmd/blkmap.c b/cmd/blkmap.c
index d5e5002..2f6ee63 100644
--- a/cmd/blkmap.c
+++ b/cmd/blkmap.c
@@ -6,6 +6,8 @@
 
 #include <blk.h>
 #include <blkmap.h>
+#include <lmb.h>
+#include <part.h>
 #include <command.h>
 #include <env.h>
 #include <malloc.h>
@@ -73,6 +75,26 @@ static int do_blkmap_map_mem(struct map_ctx *ctx, int argc, char *const argv[])
 	if (argc == 3 && !strcmp(argv[2], "preserve"))
 		preserve = true;
 
+	/*
+	 * "reserve": the memory is the disk's only copy (e.g. an image
+	 * unpacked from a download); keep EFI allocations (boot loaders
+	 * loading kernels) out of it. It becomes free again for the OS:
+	 * LMB reports it to the EFI memory map as boot services data.
+	 */
+	if (argc == 3 && !strcmp(argv[2], "reserve")) {
+		struct blk_desc *bd = dev_get_uclass_plat(((struct blkmap *)dev_get_plat(ctx->dev))->blk);
+		phys_addr_t raddr = addr;
+
+		err = lmb_alloc_mem(LMB_MEM_ALLOC_ADDR, 0, &raddr,
+				    (u64)ctx->blkcnt << bd->log2blksz,
+				    LMB_NOOVERWRITE);
+		if (err) {
+			printf("Unable to reserve %#llx: %d\n",
+			       (unsigned long long)addr, err);
+			return CMD_RET_FAILURE;
+		}
+	}
+
 	err = blkmap_map_pmem(ctx->dev, ctx->blknr, ctx->blkcnt, addr,
 			      preserve);
 	if (err) {
@@ -125,20 +147,35 @@ static int do_blkmap_map(struct cmd_tbl *cmdtp, int flag,
 static int do_blkmap_create(struct cmd_tbl *cmdtp, int flag,
 			    int argc, char *const argv[])
 {
+	struct udevice *dev;
 	const char *label;
+	ulong blksz = 0;
 	int err;
 
-	if (argc != 2)
+	if (argc != 2 && argc != 3)
 		return CMD_RET_USAGE;
 
 	label = argv[1];
+	if (argc == 3) {
+		/* block size of memory maps (linear maps take the target's) */
+		blksz = simple_strtoul(argv[2], NULL, 0);
+		if (blksz < 512 || blksz > 65536 || (blksz & (blksz - 1)))
+			return CMD_RET_USAGE;
+	}
 
-	err = blkmap_create(label, NULL);
+	err = blkmap_create(label, &dev);
 	if (err) {
 		printf("Unable to create \"%s\": %d\n", label, err);
 		return CMD_RET_FAILURE;
 	}
 
+	if (blksz) {
+		struct blk_desc *bd = dev_get_uclass_plat(((struct blkmap *)dev_get_plat(dev))->blk);
+
+		bd->blksz = blksz;
+		bd->log2blksz = LOG2(blksz);
+	}
+
 	printf("Created \"%s\"\n", label);
 	return CMD_RET_SUCCESS;
 }
@@ -224,16 +261,16 @@ U_BOOT_CMD_WITH_SUBCMDS(
 	"blkmap read <addr> <blk#> <cnt>\n"
 	"blkmap write <addr> <blk#> <cnt>\n"
 	"blkmap get <label> dev [<var>] - store device number in variable\n"
-	"blkmap create <label> - create device\n"
+	"blkmap create <label> [<blksz>] - create device (block size of memory maps, default 512)\n"
 	"blkmap destroy <label> - destroy device\n"
 	"blkmap map <label> <blk#> <cnt> linear <interface> <dev> <blk#> - device mapping\n"
-	"blkmap map <label> <blk#> <cnt> mem <addr> [preserve] - memory mapping\n",
+	"blkmap map <label> <blk#> <cnt> mem <addr> [preserve|reserve] - memory mapping\n",
 	U_BOOT_SUBCMD_MKENT(info, 2, 1, do_blkmap_common),
 	U_BOOT_SUBCMD_MKENT(part, 2, 1, do_blkmap_common),
 	U_BOOT_SUBCMD_MKENT(dev, 4, 1, do_blkmap_common),
 	U_BOOT_SUBCMD_MKENT(read, 5, 1, do_blkmap_common),
 	U_BOOT_SUBCMD_MKENT(write, 5, 1, do_blkmap_common),
 	U_BOOT_SUBCMD_MKENT(get, 5, 1, do_blkmap_get),
-	U_BOOT_SUBCMD_MKENT(create, 2, 1, do_blkmap_create),
+	U_BOOT_SUBCMD_MKENT(create, 3, 1, do_blkmap_create),
 	U_BOOT_SUBCMD_MKENT(destroy, 2, 1, do_blkmap_destroy),
 	U_BOOT_SUBCMD_MKENT(map, 32, 1, do_blkmap_map));
-- 
