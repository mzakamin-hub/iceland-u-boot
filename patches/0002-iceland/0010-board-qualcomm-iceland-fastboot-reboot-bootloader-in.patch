+
 config QCOM_GENI
 	bool "Qualcomm Generic Interface (GENI) driver"
 	depends on MISC
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index e2170212..461beaa1 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -92,3 +92,4 @@ obj-$(CONFIG_K3_BIST) += k3_bist.o
 obj-$(CONFIG_ESM_PMIC) += esm_pmic.o
 obj-$(CONFIG_SL28CPLD) += sl28cpld.o
 obj-$(CONFIG_SPL_SOCFPGA_DT_REG) += socfpga_dtreg.o
+obj-$(CONFIG_QCOM_SPMI_SDAM) += qcom-spmi-sdam.o
diff --git a/drivers/misc/qcom-spmi-sdam.c b/drivers/misc/qcom-spmi-sdam.c
new file mode 100755
index 00000000..a22be84f
--- /dev/null
+++ b/drivers/misc/qcom-spmi-sdam.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm PMIC SDAM (Shared Direct Access Memory) as a misc / nvmem device,
+ * based on the Linux driver (drivers/nvmem/qcom-spmi-sdam.c). Gives access to
+ * the SDAM's memory bytes only (from 0x40, SDAM_SIZE * 32 bytes); unlike Linux
+ * it never writes the PBS trigger registers.
+ *
+ * Copyright (c) 2017, 2020-2021, The Linux Foundation. All rights reserved.
+ */
+
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <misc.h>
+#include <power/pmic.h>
+
+#define SDAM_MEM_START			0x40
+#define SDAM_SIZE			0x44
+
+struct sdam_priv {
+	struct udevice *pmic;
+	u32 base;
+	u32 size;
+};
+
+static bool sdam_is_valid(struct sdam_priv *priv, int offset, int len)
+{
+	return len > 0 && offset >= SDAM_MEM_START &&
+	       offset + len <= SDAM_MEM_START + priv->size;
+}
+
+static int sdam_read(struct udevice *dev, int offset, void *buf, int size)
+{
+	struct sdam_priv *priv = dev_get_priv(dev);
+	u8 *b = buf;
+	int i, ret;
+
+	if (!sdam_is_valid(priv, offset, size))
+		return -EINVAL;
+
+	for (i = 0; i < size; i++) {
+		ret = pmic_reg_read(priv->pmic, priv->base + offset + i);
+		if (ret < 0)
+			return ret;
+		b[i] = ret;
+	}
+
+	return size;
+}
+
+static int sdam_write(struct udevice *dev, int offset, const void *buf,
+		      int size)
+{
+	struct sdam_priv *priv = dev_get_priv(dev);
+	const u8 *b = buf;
+	int i, ret;
+
+	/* the register map id / version and SDAM_SIZE (0x40-0x44) are read only */
+	if (!sdam_is_valid(priv, offset, size) ||
+	    (offset <= SDAM_SIZE && offset + size > 0x40))
+		return -EINVAL;
+
+	for (i = 0; i < size; i++) {
+		ret = pmic_reg_write(priv->pmic, priv->base + offset + i, b[i]);
+		if (ret)
+			return ret;
+	}
+
+	return size;
+}
+
+static const struct misc_ops sdam_ops = {
+	.read = sdam_read,
+	.write = sdam_write,
+};
+
+static int sdam_probe(struct udevice *dev)
+{
+	struct sdam_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->pmic = dev_get_parent(dev);
+
+	ret = dev_read_u32(dev, "reg", &priv->base);
+	if (ret)
+		return ret;
+
+	ret = pmic_reg_read(priv->pmic, priv->base + SDAM_SIZE);
+	if (ret < 0)
+		return ret;
+	priv->size = ret * 32;
+	if (!priv->size)
+		return -ENODEV;
+
+	return 0;
+}
+
+static const struct udevice_id sdam_ids[] = {
+	{ .compatible = "qcom,spmi-sdam" },
+	{ }
+};
+
+U_BOOT_DRIVER(qcom_spmi_sdam) = {
+	.name = "qcom-spmi-sdam",
+	.id = UCLASS_MISC,
+	.of_match = sdam_ids,
+	.ops = &sdam_ops,
+	.probe = sdam_probe,
+	.priv_auto = sizeof(struct sdam_priv),
+};
