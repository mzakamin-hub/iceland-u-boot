 obj-$(CONFIG_EFI_HAVE_CAPSULE_SUPPORT) += capsule_update.o
 obj-$(CONFIG_OF_LIVE) += of_fixup.o
diff --git a/arch/arm/mach-snapdragon/fastboot.c b/arch/arm/mach-snapdragon/fastboot.c
new file mode 100755
index 00000000..25afdd72
--- /dev/null
+++ b/arch/arm/mach-snapdragon/fastboot.c
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * `fastboot reboot-bootloader` on Qualcomm boards: before fastboot resets,
+ * store the DT's reboot mode for "bootloader" in the nvmem cell of its
+ * nvmem-reboot-mode node (on recent SoCs a PMIC SDAM byte, bits 1-7), as
+ * Linux's nvmem-reboot-mode driver does for `reboot bootloader`. The boot
+ * loader that runs after the reset (ABL) reads it and stays in its fastboot
+ * instead of booting a slot. Without such a node, or if the byte cannot be
+ * written and read back, the command fails and nothing is reset.
+ */
+
+#include <dm.h>
+#include <fastboot.h>
+#include <misc.h>
+#include <linux/bitops.h>
+#include <dm/ofnode.h>
+
+static int qcom_reboot_mode_store(const char *mode_prop)
+{
+	ofnode node = ofnode_by_compatible(ofnode_null(), "nvmem-reboot-mode");
+	struct ofnode_phandle_args args;
+	u32 mode, reg[2], bits[2] = { 0, 8 };
+	struct udevice *nvmem;
+	u8 val, check, mask;
+	int ret;
+
+	if (!ofnode_valid(node) || ofnode_read_u32(node, mode_prop, &mode))
+		return -ENOENT;
+
+	ret = ofnode_parse_phandle_with_args(node, "nvmem-cells", NULL, 0, 0, &args);
+	if (ret)
+		return ret;
+
+	/* one byte, an optional bit field inside it ("bits" = <offset count>) */
+	if (ofnode_read_u32_array(args.node, "reg", reg, 2) || reg[1] != 1)
+		return -EINVAL;
+	ofnode_read_u32_array(args.node, "bits", bits, 2);
+	if (!bits[1] || bits[0] + bits[1] > 8)
+		return -EINVAL;
+	mask = GENMASK(bits[0] + bits[1] - 1, bits[0]);
+	if ((mode << bits[0]) & ~mask)
+		return -EINVAL;
+
+	ret = uclass_get_device_by_ofnode(UCLASS_MISC, ofnode_get_parent(args.node), &nvmem);
+	if (ret)
+		return ret;
+
+	ret = misc_read(nvmem, reg[0], &val, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	val = (val & ~mask) | (mode << bits[0]);
+	ret = misc_write(nvmem, reg[0], &val, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	ret = misc_read(nvmem, reg[0], &check, 1);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	if ((check & mask) != (mode << bits[0]))
+		return -EIO;
+
+	printf("reboot mode %s = %u stored (cell %#x: %#04x)\n", mode_prop, mode, reg[0], check);
+
+	return 0;
+}
+
+int fastboot_set_reboot_flag(enum fastboot_reboot_reason reason)
+{
+	if (reason != FASTBOOT_REBOOT_REASON_BOOTLOADER)
+		return -EINVAL;
+
+	return qcom_reboot_mode_store("mode-bootloader");
+}
