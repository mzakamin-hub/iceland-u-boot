From 09ef370367cc9ce68210d2d75d8e13ee32f80f80 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 10 Oct 2026 17:00:00 +0000
Subject: [PATCH] board: qualcomm: iceland: fastboot reboot-bootloader into
 ABL's fastboot

From U-Boot started by ABL from boot_b (C0 #3), the only way back to
ABL's fastboot was the owner's Volume Down + Power, and every reset
U-Boot did was a normal boot of slot b that ABL counted down (7 -> 2
in one exit).

ABL reads the reboot reason from the PMK8850 SDAM 2 byte 0x48, bits
1-7: 2 = bootloader (Linux pmk8850.dtsi nvmem-reboot-mode; stock's
qcom,reboot-reason uses the same cell for `reboot bootloader`). With
that value it stays in its fastboot and boots no slot.

- misc: qcom-spmi-sdam: the SDAM memory bytes as a misc / nvmem
  device (port of Linux's qcom-spmi-sdam; size from SDAM_SIZE, the
  id / size registers read only, never the PBS trigger registers).
- mach-snapdragon: fastboot_set_reboot_flag() for the bootloader
  reason: store the DT's mode-bootloader in the nvmem-reboot-mode
  cell (read, modify the bit field, write, read back). Without the
  node, or if the byte does not read back, `reboot-bootloader` fails
  and nothing is reset (as before: the weak default needs a misc
  partition writer, which this board does not have).
- DT: the SDAM 2 node with the reboot-reason cell and the
  reboot-mode node, as Linux.

U-Boot still never resets by itself: the reset happens only after the
PC's `fastboot reboot-bootloader` was answered OKAY.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 arch/arm/dts/kaanapali-oneplus-iceland.dts |  22 +++++
 arch/arm/mach-snapdragon/Makefile          |   1 +
 arch/arm/mach-snapdragon/fastboot.c        |  72 ++++++++++++++
 configs/iceland_defconfig                  |   1 +
 drivers/misc/Kconfig                       |   7 ++
 drivers/misc/Makefile                      |   1 +
 drivers/misc/qcom-spmi-sdam.c              | 109 +++++++++++++++++++++
 7 files changed, 213 insertions(+)
 create mode 100755 arch/arm/mach-snapdragon/fastboot.c
 create mode 100755 drivers/misc/qcom-spmi-sdam.c

diff --git a/arch/arm/dts/kaanapali-oneplus-iceland.dts b/arch/arm/dts/kaanapali-oneplus-iceland.dts
index 13a95011..a785f1ca 100644
--- a/arch/arm/dts/kaanapali-oneplus-iceland.dts
+++ b/arch/arm/dts/kaanapali-oneplus-iceland.dts
@@ -100,6 +100,15 @@
 		method = "smc";
 	};
 
+	/* as pmk8850.dtsi in Linux (stock: qcom,reboot-reason on the same cell) */
+	reboot-mode {
+		compatible = "nvmem-reboot-mode";
+		nvmem-cells = <&reboot_reason>;
+		nvmem-cell-names = "reboot-mode";
+		mode-recovery = <0x01>;
+		mode-bootloader = <0x02>;
+	};
+
 	soc@0 {
 		compatible = "simple-bus";
 		#address-cells = <2>;
@@ -248,6 +257,19 @@
 							linux,code = <KEY_VOLUMEUP>;
 						};
 					};
+
+					nvram@7100 {
+						compatible = "qcom,spmi-sdam";
+						reg = <0x7100>;
+						#address-cells = <1>;
+						#size-cells = <1>;
+						ranges = <0 0x7100 0x100>;
+
+						reboot_reason: reboot-reason@48 {
+							reg = <0x48 0x1>;
+							bits = <1 7>;
+						};
+					};
 				};
 
 				pmic@1 {
diff --git a/arch/arm/mach-snapdragon/Makefile b/arch/arm/mach-snapdragon/Makefile
index 343e825c..ec720058 100644
--- a/arch/arm/mach-snapdragon/Makefile
+++ b/arch/arm/mach-snapdragon/Makefile
@@ -3,5 +3,6 @@
 # (C) Copyright 2015 Mateusz Kulikowski <mateusz.kulikowski@gmail.com>
 
 obj-y += board.o
