From 82abf2baa693f30207f85be894854117c5f0d837 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sat, 10 Oct 2026 15:00:00 +0000
Subject: [PATCH] board: qualcomm: iceland: Bring up USB without help from ABL

Written to boot_b and started by ABL in a normal boot (install-day
probe C0 #2, 10 Oct 2026), U-Boot's fastboot failed every time with
"dwc3-generic-peripheral usb@a600000: Reset Timed Out / failed to
initialize core": the DWC3 device soft reset (DCTL.CSFTRST) never
completes because the eUSB2 PHY gives no UTMI clock. ABL starts USB
only in its own fastboot mode, and the RAM boots (fastboot boot) always
came from there; the M31 PHY driver relied on that ("relies on the
previous bootloader to leave the supplies and repeater enabled"), the
DT gave the PHY a dummy fixed reference clock.

Do what Linux does (kaanapali.dtsi, kaanapali-oneplus-iceland.dts),
same voltages and tuning:

- DT: the PHY's reference clock is TCSR_USB2_CLKREF_EN (TCSR clock
  controller), its supplies vdd = L4F (0.88 V) and vdda12 = L1D
  (1.2 V) as RPMh regulators (apps_rsc, cmd-db), and its repeater is
  the eUSB2 repeater of PMIH0108 (SID 7 on the second SPMI bus,
  supplies L15B 1.8 V and L5B 3.1 V, stock's tuning). USB30 master
  clock 200 MHz and mock UTMI 19.2 MHz (assigned-clock-rates).
- phy: qcom: m31-eusb2: enable vdd / vdda12 and init the repeater
  ("phys") before the PHY reset, as Linux; all optional. Supplies and
  repeater stay on at power off (L1D also feeds the panel's DSI PHY
  and the UFS PHY; the OS takes them over).
- phy: qcom: add the PMIC eUSB2 repeater driver (PM8550B type), a port
  of the Linux driver; a repeater that does not report OK is logged,
  the link is still tried.
- spmi: msm: the further buses of a v8 arbiter (their APIDs follow
  the first bus's, own channel owner table) as SPMI controllers of
  their own; bounded waits for a channel's status.
- soc: qcom: rpmh-rsc: the v3 register layout for every RSC version
  from 3 on, as Linux.
- regulator: qcom-rpmh: PMH0101 / PMH0110 LDOs (PMIC5 530 LDO types,
  "L<n><pmic-id>" resource names); round a voltage up to the next set
  point (as Linux, never below the DT minimum); the first enable votes
  the requested voltage, else the DT minimum.
- clk: qcom: kaanapali: USB30 master / mock UTMI rates, TCSR clkref
  gates.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 arch/arm/dts/kaanapali-oneplus-iceland.dts    | 122 +++++++++-
 configs/iceland_defconfig                     |   1 +
 drivers/clk/qcom/clock-kaanapali.c            |  74 ++++++
 drivers/phy/qcom/Kconfig                      |   7 +
 drivers/phy/qcom/Makefile                     |   1 +
 drivers/phy/qcom/phy-qcom-eusb2-repeater.c    | 218 ++++++++++++++++++
 drivers/phy/qcom/phy-qcom-m31-eusb2.c         |  69 +++++-
 drivers/power/regulator/qcom-rpmh-regulator.c | 137 ++++++++++-
 drivers/soc/qcom/rpmh-rsc.c                   |   2 +-
 drivers/spmi/spmi-msm.c                       | 164 ++++++++++---
 10 files changed, 743 insertions(+), 52 deletions(-)
 create mode 100755 drivers/phy/qcom/phy-qcom-eusb2-repeater.c

diff --git a/arch/arm/dts/kaanapali-oneplus-iceland.dts b/arch/arm/dts/kaanapali-oneplus-iceland.dts
index 87c3b077..13a95011 100644
--- a/arch/arm/dts/kaanapali-oneplus-iceland.dts
+++ b/arch/arm/dts/kaanapali-oneplus-iceland.dts
@@ -3,14 +3,22 @@
  * Minimal DT for U-Boot on the OnePlus Pad 4: RAM, UFS, USB for fastboot,
  * the keys and ABL's framebuffer. Derived from the OnePlus 15 (infiniti)
  * board, same SoC (SM8850) and PMICs.
+ *
+ * USB is brought up by U-Boot itself (ABL starts it only in its own fastboot
+ * mode): the eUSB2 PHY's supplies (RPMh), its reference clock (TCSR) and the
+ * eUSB2 repeater on PMIH0108 (second SPMI bus), as in the Linux DT
+ * (kaanapali.dtsi, kaanapali-oneplus-iceland.dts), same voltages and tuning.
  */
 
 /dts-v1/;
 
 #include <dt-bindings/clock/qcom,kaanapali-gcc.h>
 #include <dt-bindings/clock/qcom,rpmh.h>
+#include <dt-bindings/clock/qcom,sm8750-tcsr.h>
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/soc/qcom,rpmh-rsc.h>
 #include <dt-bindings/spmi/spmi.h>
 
 / {
@@ -67,6 +75,12 @@
 		splash_region@fc800000 {
 			reg = <0x0 0xfc800000 0x0 0x02b00000>;
 		};
+
+		aop-cmd-db@81c60000 {
+			compatible = "qcom,cmd-db";
+			reg = <0x0 0x81c60000 0x0 0x20000>;
+			no-map;
+		};
 	};
 
 	gpio-keys {
@@ -86,12 +100,6 @@
 		method = "smc";
 	};
 
-	usb_ref_clk: clock-usb-ref {
-		compatible = "fixed-clock";
-		#clock-cells = <0>;
-		clock-frequency = <19200000>;
-	};
-
 	soc@0 {
 		compatible = "simple-bus";
 		#address-cells = <2>;
@@ -111,6 +119,12 @@
 			#power-domain-cells = <1>;
 		};
 
+		tcsr: clock-controller@1fc0000 {
+			compatible = "qcom,kaanapali-tcsr";
+			reg = <0x0 0x01fc0000 0x0 0x30000>;
+			#clock-cells = <1>;
+		};
+
 		ufs_mem_phy: phy@1d80000 {
 			compatible = "qcom,kaanapali-qmp-ufs-phy",
 				     "qcom,sm8750-qmp-ufs-phy";
@@ -159,9 +173,12 @@
 				     "qcom,sm8750-m31-eusb2-phy";
 			reg = <0x0 0x088e3000 0x0 0x400>;
 			#phy-cells = <0>;
-			clocks = <&usb_ref_clk>;
+			clocks = <&tcsr TCSR_USB2_CLKREF_EN>;
 			clock-names = "ref";
 			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+			vdd-supply = <&vreg_l4f_0p8>;
+			vdda12-supply = <&vreg_l1d_1p2>;
+			phys = <&pmih0108_e1_eusb2_repeater>;
 		};
 
 		usb@a600000 {
@@ -174,6 +191,9 @@
 				 <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>;
 			clock-names = "cfg_noc", "core", "iface", "sleep",
 				      "mock_utmi";
+			assigned-clocks = <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>,
+					  <&gcc GCC_USB30_PRIM_MASTER_CLK>;
+			assigned-clock-rates = <19200000>, <200000000>;
 			resets = <&gcc GCC_USB30_PRIM_BCR>;
 			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
 			phys = <&usb_1_hsphy>;
@@ -251,6 +271,94 @@
 					};
 				};
 			};
+
+			spmi@c437000 {
+				reg = <0x0 0x0c437000 0x0 0x4000>,
+				      <0x0 0x0c8d0000 0x0 0x10000>,
+				      <0x0 0x0c43b000 0x0 0x8000>;
+				reg-names = "cnfg", "intr", "chnl_owner";
+				#address-cells = <2>;
+				#size-cells = <0>;
+
+				pmic@7 {
+					compatible = "qcom,pmih0108", "qcom,spmi-pmic";
+					reg = <0x7 SPMI_USID>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					pmih0108_e1_eusb2_repeater: phy@fd00 {
+						compatible = "qcom,pm8550b-eusb2-repeater";
+						reg = <0xfd00>;
+						#phy-cells = <0>;
+						vdd18-supply = <&vreg_l15b_1p8>;
+						vdd3-supply = <&vreg_l5b_3p1>;
+
+						/* stock's device-mode tuning, as in the Linux DT */
+						qcom,tune-usb2-amplitude = /bits/ 8 <14>;
+						qcom,tune-usb2-disc-thres = /bits/ 8 <7>;
+						qcom,squelch-detector-bp = <(-2000)>;
+						qcom,tune-usb2-preem = /bits/ 8 <3>;
+						qcom,tune-usb2-slew = /bits/ 8 <2>;
+					};
+				};
+			};
+		};
+
+		apps_rsc: rsc@18900000 {
+			compatible = "qcom,rpmh-rsc";
+			reg = <0x0 0x18900000 0x0 0x10000>,
+			      <0x0 0x18910000 0x0 0x10000>,
+			      <0x0 0x18920000 0x0 0x10000>;
+			reg-names = "drv-0", "drv-1", "drv-2";
+			label = "apps_rsc";
+			qcom,tcs-offset = <0xd00>;
+			qcom,drv-id = <2>;
+			qcom,tcs-config = <ACTIVE_TCS 3>, <SLEEP_TCS 2>,
+					  <WAKE_TCS 2>, <CONTROL_TCS 0>;
+
+			/* only the supplies of the USB 2 PHY and repeater */
+			regulators-0 {
+				compatible = "qcom,pmh0101-rpmh-regulators";
+				qcom,pmic-id = "B_E0";
+
+				vreg_l5b_3p1: ldo5 {
+					regulator-name = "vreg_l5b_3p1";
+					regulator-min-microvolt = <3100000>;
+					regulator-max-microvolt = <3148000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+				};
+
+				vreg_l15b_1p8: ldo15 {
+					regulator-name = "vreg_l15b_1p8";
+					regulator-min-microvolt = <1800000>;
+					regulator-max-microvolt = <1800000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+				};
+			};
+
+			regulators-1 {
+				compatible = "qcom,pmh0110-rpmh-regulators";
+				qcom,pmic-id = "D_E0";
+
+				vreg_l1d_1p2: ldo1 {
+					regulator-name = "vreg_l1d_1p2";
+					regulator-min-microvolt = <1200000>;
+					regulator-max-microvolt = <1256000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+				};
+			};
+
+			regulators-2 {
+				compatible = "qcom,pmh0110-rpmh-regulators";
+				qcom,pmic-id = "F_E0";
+
+				vreg_l4f_0p8: ldo4 {
+					regulator-name = "vreg_l4f_0p8";
+					regulator-min-microvolt = <880000>;
+					regulator-max-microvolt = <912000>;
+					regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
+				};
+			};
 		};
 	};
 };
