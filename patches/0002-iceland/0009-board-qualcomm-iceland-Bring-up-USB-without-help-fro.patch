index 72069d30..5158d389 100644
--- a/configs/iceland_defconfig
+++ b/configs/iceland_defconfig
@@ -7,6 +7,7 @@ CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/iceland.env"
 CONFIG_ENV_RELOC_GD_ENV_ADDR=y
 CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x0
 CONFIG_PHY_QCOM_M31_EUSB2=y
+CONFIG_PHY_QCOM_EUSB2_REPEATER=y
 # CONFIG_QCOM_RPMH_POWER_DOMAIN is not set
 CONFIG_USB_FUNCTION_FASTBOOT=y
 # 1 GiB download buffer in the 9 GiB RAM bank (a rehearsal head is a few hundred MB of gzip)
diff --git a/drivers/clk/qcom/clock-kaanapali.c b/drivers/clk/qcom/clock-kaanapali.c
index 92b8b955..cda48e49 100644
--- a/drivers/clk/qcom/clock-kaanapali.c
+++ b/drivers/clk/qcom/clock-kaanapali.c
@@ -14,6 +14,7 @@
 #include <linux/bug.h>
 #include <linux/bitops.h>
 #include <dt-bindings/clock/qcom,kaanapali-gcc.h>
+#include <dt-bindings/clock/qcom,sm8750-tcsr.h>
 
 #include "clock-qcom.h"
 
@@ -41,6 +42,14 @@ static const struct freq_tbl ftbl_gcc_sdcc2_apps_clk_src[] = {
 	{ }
 };
 
+static const struct freq_tbl ftbl_gcc_usb30_prim_master_clk_src[] = {
+	F(66666667, CFG_CLK_SRC_GPLL0_EVEN, 4.5, 0, 0),
+	F(133333333, CFG_CLK_SRC_GPLL0, 4.5, 0, 0),
+	F(200000000, CFG_CLK_SRC_GPLL0, 3, 0, 0),
+	F(240000000, CFG_CLK_SRC_GPLL0, 2.5, 0, 0),
+	{ }
+};
+
 static ulong kaanapali_set_rate(struct clk *clk, ulong rate)
 {
 	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
@@ -57,6 +66,14 @@ static ulong kaanapali_set_rate(struct clk *clk, ulong rate)
 		clk_rcg_set_rate_mnd(priv->base, 0x1401c,
 				     freq->pre_div, freq->m, freq->n, freq->src, 8);
 		return freq->freq;
+	case GCC_USB30_PRIM_MASTER_CLK:
+		freq = qcom_find_freq(ftbl_gcc_usb30_prim_master_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, 0x39034,
+				     freq->pre_div, freq->m, freq->n, freq->src, 8);
+		return freq->freq;
+	case GCC_USB30_PRIM_MOCK_UTMI_CLK:
+		clk_rcg_set_rate(priv->base, 0x3904c, 1, CFG_CLK_SRC_CXO);
+		return 19200000;
 	default:
 		return 0;
 	}
@@ -239,3 +256,60 @@ U_BOOT_DRIVER(gcc_kaanapali) = {
 	.bind		= qcom_cc_bind,
 	.flags		= DM_FLAG_PRE_RELOC,
 };
+
+/* TCSRCC */
+
+static const struct gate_clk kaanapali_tcsr_clks[] = {
+	GATE_CLK(TCSR_PCIE_0_CLKREF_EN,		0x15044, BIT(0)),
+	GATE_CLK(TCSR_UFS_CLKREF_EN,		0x15054, BIT(0)),
+	GATE_CLK(TCSR_USB2_CLKREF_EN,		0x1505c, BIT(0)),
+	GATE_CLK(TCSR_USB3_CLKREF_EN,		0x1504c, BIT(0)),
+};
+
+static struct msm_clk_data kaanapali_tcsrcc_data = {
+	.clks = kaanapali_tcsr_clks,
+	.num_clks = ARRAY_SIZE(kaanapali_tcsr_clks),
+};
+
+static int tcsrcc_kaanapali_clk_enable(struct clk *clk)
+{
+	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
+
+	return qcom_gate_clk_en(priv, clk->id);
+}
+
+static int tcsrcc_kaanapali_clk_probe(struct udevice *dev)
+{
+	struct msm_clk_data *data = (struct msm_clk_data *)dev_get_driver_data(dev);
+	struct msm_clk_priv *priv = dev_get_priv(dev);
+
+	priv->base = dev_read_addr(dev);
+	if (priv->base == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	priv->data = data;
+
+	return 0;
+}
+
+static struct clk_ops tcsrcc_kaanapali_clk_ops = {
+	.enable = tcsrcc_kaanapali_clk_enable,
+};
+
+static const struct udevice_id tcsrcc_kaanapali_of_match[] = {
+	{
+		.compatible = "qcom,kaanapali-tcsr",
+		.data = (ulong)&kaanapali_tcsrcc_data,
+	},
+	{ }
+};
+
+U_BOOT_DRIVER(tcsrcc_kaanapali) = {
+	.name		= "tcsrcc_kaanapali",
+	.id		= UCLASS_CLK,
+	.of_match	= tcsrcc_kaanapali_of_match,
+	.ops		= &tcsrcc_kaanapali_clk_ops,
+	.priv_auto	= sizeof(struct msm_clk_priv),
+	.probe		= tcsrcc_kaanapali_clk_probe,
+	.flags		= DM_FLAG_DEFAULT_PD_CTRL_OFF,
+};
