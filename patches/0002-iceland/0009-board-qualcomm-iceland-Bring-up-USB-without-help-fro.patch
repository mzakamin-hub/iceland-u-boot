diff --git a/drivers/phy/qcom/phy-qcom-eusb2-repeater.c b/drivers/phy/qcom/phy-qcom-eusb2-repeater.c
new file mode 100755
index 00000000..363dfafa
--- /dev/null
+++ b/drivers/phy/qcom/phy-qcom-eusb2-repeater.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Qualcomm PMIC eUSB2 repeater, based on the Linux driver
+ * (drivers/phy/qualcomm/phy-qcom-eusb2-repeater.c).
+ *
+ * The repeater translates the eUSB2 signalling of the SoC's eUSB2 PHY to
+ * USB 2.0 levels on the connector. Enabled with its supplies and tuned as
+ * Linux does; it is left enabled for the OS (no exit), as the boot loader
+ * leaves it.
+ *
+ * Copyright (c) 2023, Linaro Limited
+ */
+
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <generic-phy.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <power/pmic.h>
+#include <power/regulator.h>
+
+/* eUSB2 status registers */
+#define EUSB2_RPTR_STATUS		0x08
+#define RPTR_OK				BIT(7)
+
+/* eUSB2 control registers */
+#define EUSB2_EN_CTL1			0x46
+#define EUSB2_RPTR_EN			BIT(7)
+
+#define EUSB2_TUNE_IUSB2		0x51
+#define EUSB2_TUNE_RES_FSDIF		0x52
+#define EUSB2_TUNE_HSDISC		0x53
+#define EUSB2_TUNE_SQUELCH_U		0x54
+#define EUSB2_TUNE_USB2_SLEW		0x55
+#define EUSB2_TUNE_USB2_PREEM		0x57
+
+#define EUSB2_RPTR_OK_TIMEOUT_US	1000
+
+static const int squelch_detector[] = {
+	[0] = -6000,
+	[1] = -5000,
+	[2] = -4000,
+	[3] = -3000,
+	[4] = -2000,
+	[5] = -1000,
+	[6] = 0,
+	[7] = 1000,
+};
+
+struct eusb2_repeater_init_tbl_reg {
+	u8 reg;
+	u8 value;
+};
+
+struct eusb2_repeater_cfg {
+	const struct eusb2_repeater_init_tbl_reg *init_tbl;
+	int init_tbl_num;
+};
+
+struct eusb2_repeater_priv {
+	struct udevice *pmic;
+	u32 base;
+	const struct eusb2_repeater_cfg *cfg;
+	struct udevice *vdd18;
+	struct udevice *vdd3;
+};
+
+static const struct eusb2_repeater_init_tbl_reg pm8550b_init_tbl[] = {
+	{ EUSB2_TUNE_IUSB2, 0x8 },
+	{ EUSB2_TUNE_SQUELCH_U, 0x3 },
+	{ EUSB2_TUNE_USB2_PREEM, 0x5 },
+};
+
+static const struct eusb2_repeater_cfg pm8550b_eusb2_cfg = {
+	.init_tbl	= pm8550b_init_tbl,
+	.init_tbl_num	= ARRAY_SIZE(pm8550b_init_tbl),
+};
+
+static int eusb2_repeater_write(struct eusb2_repeater_priv *priv, u8 reg, u8 val)
+{
+	return pmic_reg_write(priv->pmic, priv->base + reg, val);
+}
+
+static void eusb2_repeater_enable_supply(struct udevice *dev,
+					 struct udevice *supply,
+					 const char *name)
+{
+	int ret;
+
+	if (!supply)
+		return;
+
+	ret = regulator_set_enable_if_allowed(supply, true);
+	if (ret)
+		dev_err(dev, "failed to enable %s supply: %d\n", name, ret);
+}
+
+static int eusb2_repeater_init(struct phy *phy)
+{
+	struct udevice *dev = phy->dev;
+	struct eusb2_repeater_priv *priv = dev_get_priv(dev);
+	unsigned int us;
+	s32 dt_val;
+	int ret, i;
+	u8 val;
+
+	eusb2_repeater_enable_supply(dev, priv->vdd18, "vdd18");
+	eusb2_repeater_enable_supply(dev, priv->vdd3, "vdd3");
+
+	ret = eusb2_repeater_write(priv, EUSB2_EN_CTL1, EUSB2_RPTR_EN);
+	if (ret) {
+		dev_err(dev, "failed to enable the repeater: %d\n", ret);
+		return ret;
+	}
+
+	/* Write registers from init table */
+	for (i = 0; i < priv->cfg->init_tbl_num; i++)
+		eusb2_repeater_write(priv, priv->cfg->init_tbl[i].reg,
+				     priv->cfg->init_tbl[i].value);
+
+	/* Override registers from devicetree values */
+	if (!dev_read_u8(dev, "qcom,tune-usb2-preem", &val))
+		eusb2_repeater_write(priv, EUSB2_TUNE_USB2_PREEM, val);
+
+	if (!dev_read_u8(dev, "qcom,tune-usb2-disc-thres", &val))
+		eusb2_repeater_write(priv, EUSB2_TUNE_HSDISC, val);
+
+	if (!dev_read_u8(dev, "qcom,tune-usb2-amplitude", &val))
+		eusb2_repeater_write(priv, EUSB2_TUNE_IUSB2, val);
+
+	if (!dev_read_u8(dev, "qcom,tune-res-fsdif", &val))
+		eusb2_repeater_write(priv, EUSB2_TUNE_RES_FSDIF, val);
+
+	if (!dev_read_u8(dev, "qcom,tune-usb2-slew", &val))
+		eusb2_repeater_write(priv, EUSB2_TUNE_USB2_SLEW, val);
+
+	if (!dev_read_s32(dev, "qcom,squelch-detector-bp", &dt_val)) {
+		for (i = 0; i < ARRAY_SIZE(squelch_detector); i++) {
+			if (squelch_detector[i] == dt_val) {
+				eusb2_repeater_write(priv, EUSB2_TUNE_SQUELCH_U, i);
+				break;
+			}
+		}
+	}
+
+	/* Wait for status OK */
+	for (us = 0; us < EUSB2_RPTR_OK_TIMEOUT_US; us += 10) {
+		ret = pmic_reg_read(priv->pmic, priv->base + EUSB2_RPTR_STATUS);
+		if (ret >= 0 && (ret & RPTR_OK))
+			return 0;
+		udelay(10);
+	}
+
+	/* Not fatal here: let the PHY and the controller try the link */
+	dev_err(dev, "initialization timed-out (status %#x)\n", ret);
+
+	return 0;
+}
+
+static struct phy_ops eusb2_repeater_ops = {
+	.init = eusb2_repeater_init,
+};
+
+static int eusb2_repeater_get_supply(struct udevice *dev, const char *prop,
+				     struct udevice **supply)
+{
+	int ret;
+
+	ret = device_get_supply_regulator(dev, prop, supply);
+	if (ret == -ENOENT) {
+		*supply = NULL;
+		return 0;
+	}
+	if (ret) {
+		dev_err(dev, "failed to get %s: %d\n", prop, ret);
+		*supply = NULL;
+	}
+
+	return 0;
+}
+
+static int eusb2_repeater_probe(struct udevice *dev)
+{
+	struct eusb2_repeater_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->cfg = (const struct eusb2_repeater_cfg *)dev_get_driver_data(dev);
+	if (!priv->cfg)
+		return -EINVAL;
+
+	priv->pmic = dev_get_parent(dev);
+
+	ret = dev_read_u32(dev, "reg", &priv->base);
+	if (ret)
+		return ret;
+
+	eusb2_repeater_get_supply(dev, "vdd18-supply", &priv->vdd18);
+	eusb2_repeater_get_supply(dev, "vdd3-supply", &priv->vdd3);
+
+	return 0;
+}
+
+static const struct udevice_id eusb2_repeater_ids[] = {
+	{
+		.compatible = "qcom,pm8550b-eusb2-repeater",
+		.data = (ulong)&pm8550b_eusb2_cfg,
+	},
+	{ }
+};
+
+U_BOOT_DRIVER(qcom_eusb2_repeater) = {
+	.name = "qcom-eusb2-repeater",
+	.id = UCLASS_PHY,
+	.of_match = eusb2_repeater_ids,
+	.ops = &eusb2_repeater_ops,
+	.probe = eusb2_repeater_probe,
+	.priv_auto = sizeof(struct eusb2_repeater_priv),
+};
