From aea774d436a5eebee10dcb64223681c94f939e75 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 28 Sep 2026 00:40:31 +0000
Subject: [PATCH 1/2] board: qualcomm: Add OnePlus Pad 4

Support for the OnePlus Pad 4 (iceland, SM8850P), chainloaded by ABL.
Same SoC and PMICs as the OnePlus 15, so the board is derived from
Victor Fuentes' OnePlus 15 (infiniti) support: UFS, USB fastboot, keys
(volume down on PMH0101 GPIO6, as on the Pad 4) and ABL's framebuffer.

Pad 4 specifics: ABL's framebuffer at 0xfc800000 is 3392x2400 (XN251
LCD, landscape-native); RAM ranges are the large segments ABL reports on
a 12 GB unit. Boots EFI from userdata like infiniti, and names the Linux
DT on the ESP (fdtfile) for the EFI boot manager.

Signed-off-by: mzak <mzak.amin@gmail.com>
---
 arch/arm/dts/kaanapali-oneplus-iceland.dts | 256 +++++++++++++++++++++
 board/qualcomm/iceland.env                 |   8 +
 configs/iceland_defconfig                  |  24 ++
 3 files changed, 288 insertions(+)
 create mode 100644 arch/arm/dts/kaanapali-oneplus-iceland.dts
 create mode 100644 board/qualcomm/iceland.env
 create mode 100644 configs/iceland_defconfig

diff --git a/arch/arm/dts/kaanapali-oneplus-iceland.dts b/arch/arm/dts/kaanapali-oneplus-iceland.dts
new file mode 100644
index 000000000..87c3b077e
--- /dev/null
+++ b/arch/arm/dts/kaanapali-oneplus-iceland.dts
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal DT for U-Boot on the OnePlus Pad 4: RAM, UFS, USB for fastboot,
+ * the keys and ABL's framebuffer. Derived from the OnePlus 15 (infiniti)
+ * board, same SoC (SM8850) and PMICs.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/qcom,kaanapali-gcc.h>
+#include <dt-bindings/clock/qcom,rpmh.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/spmi/spmi.h>
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	model = "OnePlus Pad 4";
+	compatible = "oneplus,iceland", "qcom,kaanapali";
+
+	/*
+	 * Only used when ABL picks the DT from a header v2 boot image: ABL matches
+	 * these against the SoC (SM8850P 0x295 rev 2.0) and board (8) like the stock DT.
+	 */
+	qcom,msm-id = <0x295 0x20000>;
+	qcom,board-id = <0x08 0x00>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@fc800000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xfc800000 0x0 0x02b00000>;
+			/* XN251 LCD, 3392x2400 landscape-native, dual DSI */
+			width = <3392>;
+			height = <2400>;
+			stride = <(3392 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/*
+	 * RAM that is safe to map cacheable, leaving out firmware carveouts.
+	 * Taken from the 20 segments ABL reports on this device (12 GB):
+	 * the large ranges only. The OS gets ABL's full map through the
+	 * previous-bootloader memory fixup.
+	 */
+	memory@a6400000 {
+		device_type = "memory";
+		reg = <0x0 0xa6400000 0x0 0x1d9d0000>,
+		      <0x0 0xc4800000 0x0 0x13000000>,
+		      <0x0 0xe25a0000 0x0 0x1d260000>,
+		      <0x8 0x80000000 0x0 0x2f8fe000>,
+		      <0x8 0xb0000000 0x0 0x08100000>,
+		      <0x8 0xc0000000 0x2 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		splash_region@fc800000 {
+			reg = <0x0 0xfc800000 0x0 0x02b00000>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&key_vol_down_default>;
+		pinctrl-names = "default";
+
+		key-volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pmh0101_gpios 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	usb_ref_clk: clock-usb-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <19200000>;
+	};
+
+	soc@0 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		rpmhcc: clock-controller {
+			compatible = "qcom,kaanapali-rpmh-clk";
+			#clock-cells = <1>;
+		};
+
+		gcc: clock-controller@100000 {
+			compatible = "qcom,kaanapali-gcc";
+			reg = <0x0 0x00100000 0x0 0x1f4200>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+			#power-domain-cells = <1>;
+		};
+
+		ufs_mem_phy: phy@1d80000 {
+			compatible = "qcom,kaanapali-qmp-ufs-phy",
+				     "qcom,sm8750-qmp-ufs-phy";
+			reg = <0x0 0x01d80000 0x0 0x2000>;
+			clocks = <&rpmhcc RPMH_CXO_CLK>,
+				 <&gcc GCC_UFS_PHY_PHY_AUX_CLK>;
+			clock-names = "ref", "ref_aux";
+			power-domains = <&gcc GCC_UFS_MEM_PHY_GDSC>;
+			#phy-cells = <0>;
+		};
+
+		ufs@1d84000 {
+			compatible = "qcom,kaanapali-ufshc", "qcom,ufshc",
+				     "jedec,ufs-2.0";
+			reg = <0x0 0x01d84000 0x0 0x3000>;
+			clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
+				 <&gcc GCC_AGGRE_UFS_PHY_AXI_CLK>,
+				 <&gcc GCC_UFS_PHY_AHB_CLK>,
+				 <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
+				 <&rpmhcc RPMH_LN_BB_CLK3>,
+				 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+				 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>;
+			clock-names = "core_clk", "bus_aggr_clk", "iface_clk",
+				      "core_clk_unipro", "ref_clk",
+				      "tx_lane0_sync_clk", "rx_lane0_sync_clk",
+				      "rx_lane1_sync_clk";
+			freq-table-hz = <100000000 403000000>,
+					<0 0>,
+					<0 0>,
+					<100000000 403000000>,
+					<0 0>,
+					<0 0>,
+					<0 0>,
+					<0 0>;
+			resets = <&gcc GCC_UFS_PHY_BCR>;
+			reset-names = "rst";
+			power-domains = <&gcc GCC_UFS_PHY_GDSC>;
+			lanes-per-direction = <2>;
+			phys = <&ufs_mem_phy>;
+			phy-names = "ufsphy";
+		};
+
+		usb_1_hsphy: phy@88e3000 {
+			compatible = "qcom,kaanapali-m31-eusb2-phy",
+				     "qcom,sm8750-m31-eusb2-phy";
+			reg = <0x0 0x088e3000 0x0 0x400>;
+			#phy-cells = <0>;
+			clocks = <&usb_ref_clk>;
+			clock-names = "ref";
+			resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+		};
+
+		usb@a600000 {
+			compatible = "qcom,kaanapali-dwc3", "qcom,snps-dwc3";
+			reg = <0x0 0x0a600000 0x0 0xfc100>;
+			clocks = <&gcc GCC_CFG_NOC_USB3_PRIM_AXI_CLK>,
+				 <&gcc GCC_USB30_PRIM_MASTER_CLK>,
+				 <&gcc GCC_AGGRE_USB3_PRIM_AXI_CLK>,
+				 <&gcc GCC_USB30_PRIM_SLEEP_CLK>,
+				 <&gcc GCC_USB30_PRIM_MOCK_UTMI_CLK>;
+			clock-names = "cfg_noc", "core", "iface", "sleep",
+				      "mock_utmi";
+			resets = <&gcc GCC_USB30_PRIM_BCR>;
+			power-domains = <&gcc GCC_USB30_PRIM_GDSC>;
+			phys = <&usb_1_hsphy>;
+			phy-names = "usb2-phy";
+			dr_mode = "peripheral";
+			maximum-speed = "high-speed";
+			qcom,select-utmi-as-pipe-clk;
+			snps,dis_u2_susphy_quirk;
+			snps,dis_enblslpm_quirk;
+		};
+
+		arbiter@c400000 {
+			compatible = "qcom,kaanapali-spmi-pmic-arb",
+				     "qcom,glymur-spmi-pmic-arb";
+			reg = <0x0 0x0c400000 0x0 0x3000>,
+			      <0x0 0x0c900000 0x0 0x400000>,
+			      <0x0 0x0c4c0000 0x0 0x400000>,
+			      <0x0 0x0c403000 0x0 0x8000>;
+			reg-names = "core", "chnls", "obsrvr", "chnl_map";
+			#address-cells = <2>;
+			#size-cells = <2>;
+			ranges;
+			qcom,channel = <0>;
+			qcom,ee = <0>;
+
+			spmi@c426000 {
+				reg = <0x0 0x0c426000 0x0 0x4000>,
+				      <0x0 0x0c8c0000 0x0 0x10000>,
+				      <0x0 0x0c42a000 0x0 0x8000>;
+				reg-names = "cnfg", "intr", "chnl_owner";
+				#address-cells = <2>;
+				#size-cells = <0>;
+
+				pmic@0 {
+					compatible = "qcom,pmk8850", "qcom,spmi-pmic";
+					reg = <0x0 SPMI_USID>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					pon@1300 {
+						compatible = "qcom,pmk8350-pon";
+						reg = <0x1300>, <0x800>;
+						reg-names = "hlos", "pbs";
+
+						pwrkey {
+							compatible = "qcom,pmk8350-pwrkey";
+							linux,code = <KEY_POWER>;
+						};
+
+						resin {
+							compatible = "qcom,pmk8350-resin";
+							linux,code = <KEY_VOLUMEUP>;
+						};
+					};
+				};
+
+				pmic@1 {
+					compatible = "qcom,pmh0101", "qcom,spmi-pmic";
+					reg = <0x1 SPMI_USID>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					pmh0101_gpios: gpio@8800 {
+						compatible = "qcom,pmh0101-gpio",
+							     "qcom,spmi-gpio";
+						reg = <0x8800>;
+						gpio-controller;
+						gpio-ranges = <&pmh0101_gpios 0 0 18>;
+						#gpio-cells = <2>;
+
+						key_vol_down_default: key-vol-down-default-state {
+							pins = "gpio6";
+							power-source = <1>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
diff --git a/board/qualcomm/iceland.env b/board/qualcomm/iceland.env
new file mode 100644
index 000000000..0a38d8160
--- /dev/null
+++ b/board/qualcomm/iceland.env
@@ -0,0 +1,8 @@
+stdin=serial,button-kbd
+stdout=serial,vidconsole
+stderr=serial,vidconsole
+bootdelay=0
+# Linux DT loaded from the ESP by the EFI boot manager (dtb/<fdtfile>)
+fdtfile=qcom/kaanapali-oneplus-iceland.dtb
+userdata_blkmap=scsi scan && part start scsi 0 userdata ud_start && part size scsi 0 userdata ud_size && blkmap create userdata && blkmap map userdata 0 ${ud_size} linear scsi 0 ${ud_start}
+bootcmd=run userdata_blkmap; bootefi bootmgr; fastboot usb 0
diff --git a/configs/iceland_defconfig b/configs/iceland_defconfig
new file mode 100644
index 000000000..39fb50338
--- /dev/null
+++ b/configs/iceland_defconfig
@@ -0,0 +1,24 @@
+#include "qcom_defconfig"
+# CONFIG_OF_UPSTREAM is not set
+# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
+# CONFIG_EFI_CAPSULE_ON_DISK is not set
+CONFIG_DEFAULT_DEVICE_TREE="kaanapali-oneplus-iceland"
+CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/iceland.env"
+CONFIG_ENV_RELOC_GD_ENV_ADDR=y
+CONFIG_LNX_KRNL_IMG_TEXT_OFFSET_BASE=0x0
+CONFIG_PHY_QCOM_M31_EUSB2=y
+# CONFIG_QCOM_RPMH_POWER_DOMAIN is not set
+CONFIG_USB_FUNCTION_FASTBOOT=y
+CONFIG_FASTBOOT_BUF_ADDR=0xc6000000
+CONFIG_FASTBOOT_BUF_SIZE=0x10000000
+CONFIG_VIDEO=y
+CONFIG_VIDEO_SIMPLE=y
+# CONFIG_VIDEO_FONT_8X16 is not set
+CONFIG_VIDEO_FONT_16X32=y
+# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
+CONFIG_BUTTON_GPIO=y
+CONFIG_BUTTON_REMAP_PHONE_KEYS=y
+CONFIG_BLKMAP=y
+# CONFIG_FAT_WRITE is not set
+# CONFIG_EXT4_WRITE is not set
+CONFIG_EFI_VARIABLE_NO_STORE=y
