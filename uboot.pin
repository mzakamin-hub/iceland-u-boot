# Upstream base the patch queue applies to (sourced by scripts/prepare.sh).
UPSTREAM_URL=https://github.com/u-boot/u-boot
UPSTREAM_TAG=v2026.10-rc5
UPSTREAM_COMMIT=a06e89ab05eaa2b8344d521319399333cd760ae5

# 0001-infiniti = infiniti-mainline/u-boot main (OnePlus 15, same SoC and ABL family):
INFINITI_URL=https://github.com/infiniti-mainline/u-boot
INFINITI_COMMIT=bce42004f0758b477e5bb1affcf38592fe3c4a23
TREE_AFTER_0001_infiniti=578741d3a7e31d8dbd7b26fb6ec606ef6ca70dab
# 0002-iceland = OnePlus Pad 4 board (0001-0003) + the install build (0004-0015). Board only (0001-0003) was
# cce06382fcfc; install build v3 (0001-0010, proven on the tablet 10 Oct 2026, U-Boot commit aac9e744ec6f) was
# 158b0f7851ad8c18f87b8a3974abeae6021e02a3; install build v4 (0001-0012: + ABL's boot mode, the power-on boot
# menu; U-Boot commit e0300255e054, written to boot_b on 14 Oct 2026) was 35655ad58d6ade5168ba623f7a92507cedab28f7;
# install build v7 (0001-0015: + the stricter gate, the BlissROM entry, the Android chain from boot_a; in boot_b
# since 17 Oct 2026, image 58414017ec3e, footered 8ef94a08d7ea):
TREE_AFTER_0002_iceland=4f667505d646213b5ed223965107c1a4da439770

# AOSP mkbootimg (Apache-2.0), LineageOS mirror, fetched at build time (not vendored)
MKBOOTIMG_URL=https://github.com/LineageOS/android_system_tools_mkbootimg
MKBOOTIMG_COMMIT=808ecd09666ffe0ff5800f02af693abce56eb395

# Boot image header values: must match the boot image in the slot that will be written (anti-rollback; ABL also
# hands the AVB footer's os_version / security_patch to the TEE). The reference tablet's boot_b (an Android 17
# test-keys build, read 2 Oct 2026, before U-Boot went into boot_b): Android 17, patch level 2026-09 (footer
# security_patch 2026-09-01). Read your own boot_b header and footer before a write and use its values if they
# differ. (Stock OxygenOS 11.A.38 had Android 16 / 2026-08.)
BOOT_OS_VERSION=17.0.0
BOOT_OS_PATCH_LEVEL=2026-09
